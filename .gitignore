# Node dependencies (if we ever add any) — never commit the downloaded packages.
node_modules/

# Simulation outputs — one JSONL file per playtest game, plus aggregated reports.
# Excluded because they are large and regenerable from the code + config.
results/

# macOS Finder metadata.
.DS_Store

# wrangler dev local state (Durable Object storage, etc.) — regenerated on
# every `wrangler dev` run, never useful in version control.
.wrangler/

# The static site the Worker serves, copied by party/build-site.js.
.site/

# Local secrets for `wrangler dev`.
.dev.vars

# Production secrets, uploaded with `npx wrangler secret bulk .prod.vars`.
.prod.vars

# Leftover state of the old `partykit dev` (before the move to wrangler).
.partykit/

# Playwright end-to-end test output (npm run test:e2e).
test-results/
playwright-report/

# Archived LLM learning program (dead — see training/README.md): generated
# datasets, LoRA adapter weights and the Python venv. Large and regenerable.
training-data/
training/adapters/
training/data/
training/pilot-split/
training/.venv/
