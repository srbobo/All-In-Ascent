# Node dependencies (if we ever add any) — never commit the downloaded packages.
node_modules/

# Simulation outputs — one JSONL file per playtest game, plus aggregated reports.
# Excluded because they are large and regenerable from the code + config.
results/

# macOS Finder metadata.
.DS_Store

# PartyKit dev-server local state (Durable Object cache, etc.) — regenerated on
# every `partykit dev` run, never useful in version control.
.partykit/

# Playwright end-to-end test output (npm run test:e2e).
test-results/
playwright-report/

# Archived LLM learning program (dead — see training/README.md): generated
# datasets, LoRA adapter weights and the Python venv. Large and regenerable.
training-data/
training/adapters/
training/data/
training/pilot-split/
training/.venv/
